# vmd/tests/test_registry.test
# tcltest suite for the pure-layer registry module.
# Run under headless VMD: bash -ic 'cd tmp/biochemeleon-vmd && vmd -dispdev text -e vmd/tests/test_registry.test -eofexit < /dev/null'
# (Or standalone tclsh if installed: tclsh vmd/tests/test_registry.test)

package require tcltest
namespace import ::tcltest::*
configure -verbose {start pass body error}

# Source the pure layer. Under `vmd -e`, [info script] is EMPTY (verified),
# so use [pwd] (VMD cwd = the staging root) to locate files.
source [file join [pwd] vmd lib registry.tcl]

# Dependency injection: inject a fake fetch_hider_ids (a command prefix)
# that returns a fixed list. Built with [list apply ...] so the prefix is
# passed as a VALUE (not evaluated at the call site); the registry invokes
# it via {expand}. No molecular-viewer API needed — pure unit test.

test reconstruct_clears_and_populates {} -body {
    ::biochemeleon::registry::reconstruct_from_sentinels [list apply {{} { return {5 10 15} }}]
    list [::biochemeleon::registry::is_hider 5] [::biochemeleon::registry::is_hider 10] [::biochemeleon::registry::is_hider 15] [::biochemeleon::registry::is_hider 99]
} -result {1 1 1 0}

test reconstruct_clears_previous {} -body {
    ::biochemeleon::registry::reconstruct_from_sentinels [list apply {{} { return {20 30} }}]
    list [::biochemeleon::registry::is_hider 5] [::biochemeleon::registry::is_hider 20] [::biochemeleon::registry::is_hider 30]
} -result {0 1 1}

test reconstruct_empty_list {} -body {
    ::biochemeleon::registry::reconstruct_from_sentinels [list apply {{} { return [list] }}]
    ::biochemeleon::registry::is_hider 1
} -result 0

test mark_found_sets_status {} -body {
    ::biochemeleon::registry::reconstruct_from_sentinels [list apply {{} { return {7} }}]
    ::biochemeleon::registry::mark_found 7
    # No direct status reader in the Phase 13 stub — assert mark_found
    # did not error and is_hider is still true.
    ::biochemeleon::registry::is_hider 7
} -result 1

test mark_found_unregistered_errors {} -body {
    catch {::biochemeleon::registry::mark_found 999} err
    set err
} -result {hider 999 not registered}

# ---- Phase 15 additions: count_hiders + reset + bound-arg DI ----

test count_hiders_after_reconstruct {} -body {
    ::biochemeleon::registry::reconstruct_from_sentinels [list apply {{} { return {5 10 15} }}]
    ::biochemeleon::registry::count_hiders
} -result 3

test count_hiders_empty {} -body {
    ::biochemeleon::registry::reconstruct_from_sentinels [list apply {{} { return [list] }}]
    ::biochemeleon::registry::count_hiders
} -result 0

test reset_clears_records {} -body {
    ::biochemeleon::registry::reconstruct_from_sentinels [list apply {{} { return {1 2} }}]
    ::biochemeleon::registry::reset
    list [::biochemeleon::registry::count_hiders] [::biochemeleon::registry::is_hider 1]
} -result {0 0}

# Mirrors game.tcl's molid-bound apply-lambda injection shape (bound arg, no atomselect).
# Proves [{*}$fetch_hider_ids] expands the 3-element command prefix (apply {lambda} <arg>).
test reconstruct_with_bound_arg_lambda {} -body {
    ::biochemeleon::registry::reconstruct_from_sentinels \
        [list apply {{fake_molid} { return {7 8} }} "dummy_molid"]
    list [::biochemeleon::registry::is_hider 7] \
         [::biochemeleon::registry::is_hider 8] \
         [::biochemeleon::registry::count_hiders]
} -result {1 1 2}

# ---- Phase 16 additions: found-state surface (status_of / count_remaining /
# ---- remaining_by_rep) + the optional rep arg on reconstruct_from_sentinels.

# 2-arg reconstruct stamps every record with the given rep ("VDW" = the
# Phase-16 sphere tier's GAME_REPS name). status_of + remaining_by_rep see it.
test reconstruct_with_rep_arg {} -body {
    ::biochemeleon::registry::reconstruct_from_sentinels [list apply {{} { return {5 6} }}] "VDW"
    list [expr {[::biochemeleon::registry::status_of 5] eq "hidden"}] \
         [expr {[::biochemeleon::registry::remaining_by_rep] eq [dict create VDW 2]}]
} -result {1 1}

test status_of_unregistered_is_empty {} -body {
    ::biochemeleon::registry::reconstruct_from_sentinels [list apply {{} { return [list] }}]
    ::biochemeleon::registry::status_of 999
} -result {}

test status_of_after_mark_found {} -body {
    ::biochemeleon::registry::reconstruct_from_sentinels [list apply {{} { return {5} }}]
    ::biochemeleon::registry::mark_found 5
    ::biochemeleon::registry::status_of 5
} -result {found}

test count_remaining_counts_hidden_only {} -body {
    ::biochemeleon::registry::reconstruct_from_sentinels [list apply {{} { return {5 10 15} }}]
    ::biochemeleon::registry::mark_found 5
    ::biochemeleon::registry::count_remaining
} -result 2

test count_remaining_after_reset {} -body {
    ::biochemeleon::registry::reconstruct_from_sentinels [list apply {{} { return {1 2} }}]
    ::biochemeleon::registry::reset
    ::biochemeleon::registry::count_remaining
} -result 0

test remaining_by_rep_groups_and_sums {} -body {
    ::biochemeleon::registry::reconstruct_from_sentinels [list apply {{} { return {1 2 3} }}] "VDW"
    ::biochemeleon::registry::mark_found 1
    set sum 0
    dict for {r c} [::biochemeleon::registry::remaining_by_rep] { incr sum $c }
    list [expr {[::biochemeleon::registry::remaining_by_rep] eq [dict create VDW 2]}] \
         [expr {$sum eq [::biochemeleon::registry::count_remaining]}]
} -result {1 1}

# 1-arg reconstruct leaves rep "" — per-rep remaining skips those records even
# though the total hidden count is non-zero (v1 registry.py:274-295 parity).
test remaining_by_rep_skips_empty_rep {} -body {
    ::biochemeleon::registry::reconstruct_from_sentinels [list apply {{} { return {3 4} }}]
    list [expr {[::biochemeleon::registry::remaining_by_rep] eq [dict create]}] \
         [::biochemeleon::registry::count_remaining]
} -result {1 2}

# mark_found is a silent idempotent overwrite (probe F19) — double-marking
# neither errors nor double-decrements; the three-way guard lives in the caller.
test mark_found_idempotent {} -body {
    ::biochemeleon::registry::reconstruct_from_sentinels [list apply {{} { return {5 6} }}] "VDW"
    set rc [catch {::biochemeleon::registry::mark_found 5} err]
    ::biochemeleon::registry::mark_found 5
    list $rc [::biochemeleon::registry::count_remaining] [::biochemeleon::registry::is_hider 5]
} -result {0 1 1}

# The original 1-arg call form keeps working (backward-compat proof):
# records exist and are counted hidden, but remaining_by_rep is empty (rep "").
test one_arg_reconstruct_still_works {} -body {
    ::biochemeleon::registry::reconstruct_from_sentinels [list apply {{} { return {42} }}]
    list [::biochemeleon::registry::is_hider 42] \
         [expr {[::biochemeleon::registry::remaining_by_rep] eq [dict create]}] \
         [::biochemeleon::registry::count_remaining]
} -result {1 1 1}

# CRITICAL: read numTests BEFORE cleanupTests (cleanupTests resets the array).
# Print a machine-parseable marker — VMD does NOT propagate tcl exit codes
# ($? is always 0 from VMD), so the harness MUST parse this marker line.
set total $::tcltest::numTests(Total)
set passed $::tcltest::numTests(Passed)
set failed $::tcltest::numTests(Failed)
set skipped $::tcltest::numTests(Skipped)
puts "BCHM_TEST_RESULT Total=$total Passed=$passed Failed=$failed Skipped=$skipped"
cleanupTests
