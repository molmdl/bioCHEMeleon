# vmd/tests/test_registry.test
# tcltest suite for the pure-layer registry module.
# Run under headless VMD: bash -ic 'cd tmp/biochemeleon-vmd && vmd -dispdev text -e vmd/tests/test_registry.test -eofexit < /dev/null'
# (Or standalone tclsh if installed: tclsh vmd/tests/test_registry.test)

package require tcltest
namespace import ::tcltest::*
configure -verbose {start pass body error}

# Source the pure layer. Under `vmd -e`, [info script] is EMPTY (verified),
# so use [pwd] (VMD cwd = the staging root) to locate files.
source [file join [pwd] vmd lib registry.tcl]

# Dependency injection: inject a fake fetch_hider_ids (a command prefix)
# that returns a fixed list. Built with [list apply ...] so the prefix is
# passed as a VALUE (not evaluated at the call site); the registry invokes
# it via {expand}. No molecular-viewer API needed — pure unit test.

test reconstruct_clears_and_populates {} -body {
    ::biochemeleon::registry::reconstruct_from_sentinels [list apply {{} { return {5 10 15} }}]
    list [::biochemeleon::registry::is_hider 5] [::biochemeleon::registry::is_hider 10] [::biochemeleon::registry::is_hider 15] [::biochemeleon::registry::is_hider 99]
} -result {1 1 1 0}

test reconstruct_clears_previous {} -body {
    ::biochemeleon::registry::reconstruct_from_sentinels [list apply {{} { return {20 30} }}]
    list [::biochemeleon::registry::is_hider 5] [::biochemeleon::registry::is_hider 20] [::biochemeleon::registry::is_hider 30]
} -result {0 1 1}

test reconstruct_empty_list {} -body {
    ::biochemeleon::registry::reconstruct_from_sentinels [list apply {{} { return [list] }}]
    ::biochemeleon::registry::is_hider 1
} -result 0

test mark_found_sets_status {} -body {
    ::biochemeleon::registry::reconstruct_from_sentinels [list apply {{} { return {7} }}]
    ::biochemeleon::registry::mark_found 7
    # No direct status reader in the Phase 13 stub — assert mark_found
    # did not error and is_hider is still true.
    ::biochemeleon::registry::is_hider 7
} -result 1

test mark_found_unregistered_errors {} -body {
    catch {::biochemeleon::registry::mark_found 999} err
    set err
} -result {hider 999 not registered}

# ---- Phase 15 additions: count_hiders + reset + bound-arg DI ----

test count_hiders_after_reconstruct {} -body {
    ::biochemeleon::registry::reconstruct_from_sentinels [list apply {{} { return {5 10 15} }}]
    ::biochemeleon::registry::count_hiders
} -result 3

test count_hiders_empty {} -body {
    ::biochemeleon::registry::reconstruct_from_sentinels [list apply {{} { return [list] }}]
    ::biochemeleon::registry::count_hiders
} -result 0

test reset_clears_records {} -body {
    ::biochemeleon::registry::reconstruct_from_sentinels [list apply {{} { return {1 2} }}]
    ::biochemeleon::registry::reset
    list [::biochemeleon::registry::count_hiders] [::biochemeleon::registry::is_hider 1]
} -result {0 0}

# Mirrors game.tcl's molid-bound apply-lambda injection shape (bound arg, no atomselect).
# Proves [{*}$fetch_hider_ids] expands the 3-element command prefix (apply {lambda} <arg>).
test reconstruct_with_bound_arg_lambda {} -body {
    ::biochemeleon::registry::reconstruct_from_sentinels \
        [list apply {{fake_molid} { return {7 8} }} "dummy_molid"]
    list [::biochemeleon::registry::is_hider 7] \
         [::biochemeleon::registry::is_hider 8] \
         [::biochemeleon::registry::count_hiders]
} -result {1 1 2}

# ---- Phase 16 additions: found-state surface (status_of / count_remaining /
# ---- remaining_by_rep) + the optional rep arg on reconstruct_from_sentinels.

# 2-arg reconstruct stamps every record with the given rep ("VDW" = the
# Phase-16 sphere tier's GAME_REPS name). status_of + remaining_by_rep see it.
test reconstruct_with_rep_arg {} -body {
    ::biochemeleon::registry::reconstruct_from_sentinels [list apply {{} { return {5 6} }}] "VDW"
    list [expr {[::biochemeleon::registry::status_of 5] eq "hidden"}] \
         [expr {[::biochemeleon::registry::remaining_by_rep] eq [dict create VDW 2]}]
} -result {1 1}

test status_of_unregistered_is_empty {} -body {
    ::biochemeleon::registry::reconstruct_from_sentinels [list apply {{} { return [list] }}]
    ::biochemeleon::registry::status_of 999
} -result {}

test status_of_after_mark_found {} -body {
    ::biochemeleon::registry::reconstruct_from_sentinels [list apply {{} { return {5} }}]
    ::biochemeleon::registry::mark_found 5
    ::biochemeleon::registry::status_of 5
} -result {found}

test count_remaining_counts_hidden_only {} -body {
    ::biochemeleon::registry::reconstruct_from_sentinels [list apply {{} { return {5 10 15} }}]
    ::biochemeleon::registry::mark_found 5
    ::biochemeleon::registry::count_remaining
} -result 2

test count_remaining_after_reset {} -body {
    ::biochemeleon::registry::reconstruct_from_sentinels [list apply {{} { return {1 2} }}]
    ::biochemeleon::registry::reset
    ::biochemeleon::registry::count_remaining
} -result 0

test remaining_by_rep_groups_and_sums {} -body {
    ::biochemeleon::registry::reconstruct_from_sentinels [list apply {{} { return {1 2 3} }}] "VDW"
    ::biochemeleon::registry::mark_found 1
    set sum 0
    dict for {r c} [::biochemeleon::registry::remaining_by_rep] { incr sum $c }
    list [expr {[::biochemeleon::registry::remaining_by_rep] eq [dict create VDW 2]}] \
         [expr {$sum eq [::biochemeleon::registry::count_remaining]}]
} -result {1 1}

# 1-arg reconstruct leaves rep "" — per-rep remaining skips those records even
# though the total hidden count is non-zero (v1 registry.py:274-295 parity).
test remaining_by_rep_skips_empty_rep {} -body {
    ::biochemeleon::registry::reconstruct_from_sentinels [list apply {{} { return {3 4} }}]
    list [expr {[::biochemeleon::registry::remaining_by_rep] eq [dict create]}] \
         [::biochemeleon::registry::count_remaining]
} -result {1 2}

# mark_found is a silent idempotent overwrite (probe F19) — double-marking
# neither errors nor double-decrements; the three-way guard lives in the caller.
test mark_found_idempotent {} -body {
    ::biochemeleon::registry::reconstruct_from_sentinels [list apply {{} { return {5 6} }}] "VDW"
    set rc [catch {::biochemeleon::registry::mark_found 5} err]
    ::biochemeleon::registry::mark_found 5
    list $rc [::biochemeleon::registry::count_remaining] [::biochemeleon::registry::is_hider 5]
} -result {0 1 1}

# The original 1-arg call form keeps working (backward-compat proof):
# records exist and are counted hidden, but remaining_by_rep is empty (rep "").
test one_arg_reconstruct_still_works {} -body {
    ::biochemeleon::registry::reconstruct_from_sentinels [list apply {{} { return {42} }}]
    list [::biochemeleon::registry::is_hider 42] \
         [expr {[::biochemeleon::registry::remaining_by_rep] eq [dict create]}] \
         [::biochemeleon::registry::count_remaining]
} -result {1 1 1}

# ---- Phase 17.1 additions: per-record rep API (set_rep / assign_reps) ----
# Multi-tier rounds call reconstruct_from_sentinels ONCE (it clears +
# single-rep stamps — P17D/P8: a second call wipes prior tiers), then stamp
# each hider's tier via the per-record API below. These cases pin the error
# contract (exact mark_found wording), status preservation, atomicity, and
# the multi-tier remaining_by_rep interaction BEFORE game.tcl consumes it.

# set_rep stamps ONE record's rep field (1-arg reconstruct leaves rep "").
test set_rep_sets_field {} -body {
    ::biochemeleon::registry::reconstruct_from_sentinels [list apply {{} { return {5} }}]
    ::biochemeleon::registry::set_rep 5 Lines
    expr {[::biochemeleon::registry::remaining_by_rep] eq [dict create Lines 1]}
} -result 1

# set_rep OVERWRITES any prior rep value, including a 2-arg reconstruct stamp.
test set_rep_overwrites {} -body {
    ::biochemeleon::registry::reconstruct_from_sentinels [list apply {{} { return {5} }}] "VDW"
    ::biochemeleon::registry::set_rep 5 Lines
    expr {[::biochemeleon::registry::remaining_by_rep] eq [dict create Lines 1]}
} -result 1

# Unregistered idx errors with the EXACT mark_found wording.
test set_rep_unregistered_errors {} -body {
    ::biochemeleon::registry::reconstruct_from_sentinels [list apply {{} { return {5} }}]
    catch {::biochemeleon::registry::set_rep 999 X} err
    set err
} -result {hider 999 not registered}

# set_rep changes ONLY rep — status ("found") survives the stamp, and found
# records stay excluded from remaining_by_rep (GAME-03 contract).
test set_rep_keeps_status {} -body {
    ::biochemeleon::registry::reconstruct_from_sentinels [list apply {{} { return {5} }}]
    ::biochemeleon::registry::mark_found 5
    ::biochemeleon::registry::set_rep 5 Lines
    list [expr {[::biochemeleon::registry::status_of 5] eq "found"}] \
         [expr {[::biochemeleon::registry::remaining_by_rep] eq [dict create]}]
} -result {1 1}

# Bulk tier assignment: 2x VDW + 2x Lines — per-tier hidden counts visible.
test assign_reps_bulk {} -body {
    ::biochemeleon::registry::reconstruct_from_sentinels [list apply {{} { return {5 6 7 8} }}]
    ::biochemeleon::registry::assign_reps {5 VDW 6 VDW 7 Lines 8 Lines}
    expr {[::biochemeleon::registry::remaining_by_rep] eq [dict create VDW 2 Lines 2]}
} -result 1

# ATOMICITY: one unregistered key aborts the WHOLE assign BEFORE any record
# is touched — idx 5's rep stays "" (skipped by remaining_by_rep) and every
# record is still intact (count_remaining unchanged).
test assign_reps_atomic {} -body {
    ::biochemeleon::registry::reconstruct_from_sentinels [list apply {{} { return {5 6} }}]
    set rc [catch {::biochemeleon::registry::assign_reps {5 VDW 999 Lines}} err]
    list $rc $err \
         [expr {[::biochemeleon::registry::remaining_by_rep] eq [dict create]}] \
         [::biochemeleon::registry::count_remaining]
} -result {1 {hider 999 not registered} 1 2}

# Empty mapping is a no-op (no error, no state change).
test assign_reps_empty_noop {} -body {
    ::biochemeleon::registry::reconstruct_from_sentinels [list apply {{} { return {5} }}]
    set rc [catch {::biochemeleon::registry::assign_reps [dict create]} err]
    list $rc [expr {[::biochemeleon::registry::remaining_by_rep] eq [dict create]}] \
         [::biochemeleon::registry::count_remaining]
} -result {0 1 1}

# Found records are stamped too (rep is set) but stay excluded from the
# per-tier remaining counts (GAME-03).
test assign_reps_after_mark_found {} -body {
    ::biochemeleon::registry::reconstruct_from_sentinels [list apply {{} { return {5 6} }}]
    ::biochemeleon::registry::mark_found 5
    ::biochemeleon::registry::assign_reps {5 VDW 6 Lines}
    expr {[::biochemeleon::registry::remaining_by_rep] eq [dict create Lines 1]}
} -result 1

# Multi-tier consistency: the per-tier remaining counts sum to the total
# remaining (Game tab's total vs per-rep labels can never disagree).
test multi_tier_total_consistency {} -body {
    ::biochemeleon::registry::reconstruct_from_sentinels [list apply {{} { return {5 6 7 8} }}]
    ::biochemeleon::registry::assign_reps {5 VDW 6 VDW 7 Lines 8 Lines}
    set sum 0
    dict for {r c} [::biochemeleon::registry::remaining_by_rep] { incr sum $c }
    expr {$sum eq [::biochemeleon::registry::count_remaining]}
} -result 1

# ---- Phase 17.2 additions: resid-block lookup (register_resid_block /
# ---- hider_for_resid) ----
# The multi-atom pick fallback's PURE half: a cartoon splice registers ONE
# fake GAM residue per hider (beta=-999 on the CA only), but a real click on
# the cartoon bump can land on the residue's N/C/O/CB. The dispatch builds a
# resid -> hider-index map (fake resid 9001+k -> the registered CA index) and
# registers it ONCE per round via register_resid_block; on_pick's fallback
# resolves a non-registered clicked index by reading its resid (mol side,
# game.tcl) and looking it up here. The v2 analog of v1's
# get_altconf_by_resv dual lookup, keyed `resid ∈ registered block`.

# Basic round trip: the dispatch's map registers and both resids resolve
# to their registered CA indices.
test register_and_lookup {} -body {
    ::biochemeleon::registry::reconstruct_from_sentinels [list apply {{} { return {5 6} }}]
    ::biochemeleon::registry::register_resid_block {9001 5 9002 6}
    list [::biochemeleon::registry::hider_for_resid 9001] \
         [::biochemeleon::registry::hider_for_resid 9002]
} -result {5 6}

# WHOLESALE REPLACE: the second call replaces the whole block — never merged
# with a prior round's block (one call per round; a stale entry from the
# first block must not survive).
test register_replace_wholesale {} -body {
    ::biochemeleon::registry::reconstruct_from_sentinels [list apply {{} { return {5 6} }}]
    ::biochemeleon::registry::register_resid_block {9001 5}
    ::biochemeleon::registry::register_resid_block {9002 6}
    list [::biochemeleon::registry::hider_for_resid 9001] \
         [::biochemeleon::registry::hider_for_resid 9002]
} -result {{} 6}

# ATOMIC validate-then-replace: one unregistered idx aborts the WHOLE
# registration BEFORE the block is touched — the exact mark_found error
# wording, and no partial application (9001 stays unregistered).
test register_unregistered_atomic {} -body {
    ::biochemeleon::registry::reconstruct_from_sentinels [list apply {{} { return {5} }}]
    set rc [catch {::biochemeleon::registry::register_resid_block {9001 5 9002 999}} err]
    list $rc $err [::biochemeleon::registry::hider_for_resid 9001]
} -result {1 {hider 999 not registered} {}}

# Empty mapping is a no-op — the block is UNCHANGED, not cleared (contract:
# "empty mapping → no-op (block unchanged)"). Two halves: (a) the literal
# sequence (no error; 9001 stays unregistered); (b) the unchanged pin (a
# prior entry survives an empty-mapping call).
test register_empty_noop {} -body {
    ::biochemeleon::registry::reconstruct_from_sentinels [list apply {{} { return {5} }}]
    set rc [catch {::biochemeleon::registry::register_resid_block [dict create]} err]
    ::biochemeleon::registry::register_resid_block {9001 5}
    ::biochemeleon::registry::register_resid_block [dict create]
    list $rc [::biochemeleon::registry::hider_for_resid 9001]
} -result {0 5}

# Empty mapping on an EMPTY registry is fine too — the validate loop runs
# zero times (no keys to validate against nonexistent records); a real block
# registers cleanly once records exist later.
test register_nonexistent_records_ok_when_replaced_later {} -body {
    ::biochemeleon::registry::reset
    set rc [catch {::biochemeleon::registry::register_resid_block [dict create]} err]
    ::biochemeleon::registry::reconstruct_from_sentinels [list apply {{} { return {5} }}]
    ::biochemeleon::registry::register_resid_block {9001 5}
    list $rc [::biochemeleon::registry::hider_for_resid 9001]
} -result {0 5}

# Unknown resid -> "" (string-empty, NEVER an error — the miss path is a
# normal "Miss!" pick).
test lookup_unknown {} -body {
    ::biochemeleon::registry::hider_for_resid 42
} -result {}

# reset clears BOTH _records and _resid_block — a stale block must not
# survive cleanup into the next round.
test lookup_after_reset {} -body {
    ::biochemeleon::registry::reconstruct_from_sentinels [list apply {{} { return {5} }}]
    ::biochemeleon::registry::register_resid_block {9001 5}
    ::biochemeleon::registry::reset
    ::biochemeleon::registry::hider_for_resid 9001
} -result {}

# PINNED lifecycle: reconstruct_from_sentinels does NOT touch _resid_block
# (only reset and register_resid_block mutate it) — a registered block
# SURVIVES a reconstruct call. The dispatch always re-registers after
# reconstruct in residue rounds, but the registry itself never wipes it.
test block_survives_reconstruct {} -body {
    ::biochemeleon::registry::reconstruct_from_sentinels [list apply {{} { return {5} }}]
    ::biochemeleon::registry::register_resid_block {9001 5}
    ::biochemeleon::registry::reconstruct_from_sentinels [list apply {{} { return {5} }}]
    list [::biochemeleon::registry::hider_for_resid 9001] [::biochemeleon::registry::is_hider 5]
} -result {5 1}

# The two maps are INDEPENDENT: the resid block (resid -> idx) and the
# per-record rep stamps (idx -> rep) never interfere with each other.
test block_orthogonal_to_assign_reps {} -body {
    ::biochemeleon::registry::reconstruct_from_sentinels [list apply {{} { return {5} }}]
    ::biochemeleon::registry::register_resid_block {9001 5}
    ::biochemeleon::registry::assign_reps {5 Cartoon}
    list [::biochemeleon::registry::hider_for_resid 9001] \
         [expr {[::biochemeleon::registry::remaining_by_rep] eq [dict create Cartoon 1]}]
} -result {5 1}

# Mixed-round shape (harmless 9001 collision): in a round with a simple tier
# AND a residue tier, the simple-tier single-atom hiders all share resid 9001
# (17.2-01 RESID_BASE) but are NOT in the block. A click on one of them is
# registered (is_hider first), so the fallback only ever fires for fake
# residues' N/C/O/CB — the block maps 9001 to the residue-tier CA (idx 8
# here), never to a simple-tier atom.
test mixed_round_shape {} -body {
    ::biochemeleon::registry::reconstruct_from_sentinels [list apply {{} { return {7 8 9} }}]
    ::biochemeleon::registry::register_resid_block {9001 8 9002 9}
    ::biochemeleon::registry::hider_for_resid 9001
} -result 8

# CRITICAL: read numTests BEFORE cleanupTests (cleanupTests resets the array).
# Print a machine-parseable marker — VMD does NOT propagate tcl exit codes
# ($? is always 0 from VMD), so the harness MUST parse this marker line.
set total $::tcltest::numTests(Total)
set passed $::tcltest::numTests(Passed)
set failed $::tcltest::numTests(Failed)
set skipped $::tcltest::numTests(Skipped)
puts "BCHM_TEST_RESULT Total=$total Passed=$passed Failed=$failed Skipped=$skipped"
cleanupTests
